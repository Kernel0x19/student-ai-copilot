DEBUG=true
DATABASE_URL=sqlite:///./edupilot.db
CHROMA_PATH=./chroma_data
CORS_ORIGINS=http://localhost:3000
DEV_MODE=true
REDIS_URL=redis://localhost:6379/0

# PostgreSQL Configuration (when migrating from SQLite)
# Set POSTGRES_PASSWORD to enable PostgreSQL. Leave empty to use SQLite.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edupilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# TEE Configuration
TEE_MODE=mock

# Notification Services
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
FIREBASE_CREDENTIALS_PATH=
NOTIFICATION_FROM_EMAIL=noreply@edupilot.local

# Data Connectors
UNSTOP_API_KEY=
ENABLED_CONNECTORS=aicte,unstop,internshala

# Ollama Configuration
# Run `ollama pull llama3.2:3b` before starting the backend.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL= gpt-oss:120b-cloud 
OLLAMA_TEMPERATURE=0.7

# Document Verification
TESSERACT_CMD=
UIDAI_API_KEY=
UIDAI_API_URL=

# Encryption & Security
ENCRYPTION_KEY_MASTER=
AUDIT_LOG_RETENTION_DAYS=1095

# Auto-verification thresholds
AUTO_APPROVAL_THRESHOLD=0.85
REVIEW_THRESHOLD=0.60
